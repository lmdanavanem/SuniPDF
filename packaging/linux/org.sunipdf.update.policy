<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SuniPDF</vendor>
  <vendor_url>https://github.com/lmdanavanem/SuniPDF</vendor_url>
  <icon_name>sunipdf</icon_name>
  <action id="org.sunipdf.update">
    <description>Install a verified SuniPDF update</description>
    <message>Administrator authorization is required to install this verified SuniPDF update.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/sunipdf/install-update</annotate>
  </action>
</policyconfig>
